{
  "name": "@sb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:scenarios": "vitest run test/scenarios.test.ts --reporter=verbose",
    "simulate": "tsx src/simulate.ts",
    "test:pg": "SCENARIO_PG=1 vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.2.0",
    "@sb/core": "workspace:*",
    "@sb/db": "workspace:*",
    "@sb/providers": "workspace:*",
    "bullmq": "^5.71.0",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
