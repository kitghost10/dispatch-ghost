# ---------------------------------------------------------------------------
# Sonic Bold AI Receptionist — environment variables
# Copy to .env and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# mock = no real Twilio/ElevenLabs (scripted voice, fake SMS outbox, demo data)
# live = real providers; the API refuses to start without the required keys
APP_MODE=mock
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public HTTPS URL Twilio can reach (webhooks, Media Stream wss://, signature validation).
# Required in live mode. Defaults to http://localhost:$PORT in mock mode.
# PUBLIC_BASE_URL=https://voice.example.com

# Long random string (e.g. `openssl rand -base64 48`). Signs dashboard sessions and stream tokens.
SESSION_SECRET=dev-only-session-secret-change-me

# Dashboard
DASHBOARD_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Postgres (omit DATABASE_URL in mock mode to use the in-memory store)
# The API connects as the non-owner sb_app role so row-level security applies.
# Migrations run as the owner role.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://sb_app:CHANGE_ME@localhost:5432/sonicbold
# MIGRATION_DATABASE_URL=postgres://sb_owner:CHANGE_ME@localhost:5432/sonicbold
# SB_APP_DB_PASSWORD=CHANGE_ME          # migrate sets sb_app's LOGIN password

# Redis/BullMQ for background jobs (SMS retries, missed-call text-backs, calendar/FSM sync).
# Without it (or with RUN_WORKER_INLINE=true) jobs run inside the API process.
# REDIS_URL=redis://localhost:6379
# RUN_WORKER_INLINE=false

# Mock mode demo data
SEED_DEMO=true
SEED_ADMIN_PASSWORD=sonicbold-demo

# ---------------------------------------------------------------------------
# Twilio (live mode)
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Messaging Service with the A2P 10DLC campaign attached (see docs/a2p-10dlc.md)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# true if Twilio Advanced Opt-Out answers STOP/HELP for you (we then don't send our own reply)
# TWILIO_ADVANCED_OPT_OUT=false
# Keep true in production. Only disable for local tunnels that rewrite URLs.
TWILIO_VALIDATE_SIGNATURES=true

# ---------------------------------------------------------------------------
# Voice (live mode) — ElevenLabs Agents over Twilio Media Streams (default)
# Create a Conversational AI agent in ElevenLabs, then set the id below.
# The API will attach receptionist client tools and switch the agent to
# ulaw_8000 so Twilio audio does not need transcoding.
# ---------------------------------------------------------------------------
# VOICE_PROVIDER=elevenlabs             # or "openai-realtime" or "mock"
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional fallback / SMS LLM (SMS AI replies still use OpenAI if set)
# OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SMS_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Google Calendar booking (service account JSON, single line). Share each
# plumber's calendar with the service account email; set calendar.calendarId
# in the tenant settings.
# ---------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# ---------------------------------------------------------------------------
# Field-service software (off by default; see docs/field-service.md)
# *_ENABLED turns the adapter on; *_LIVE lets it make real API writes (otherwise dry-run logs).
# ---------------------------------------------------------------------------
FSM_SERVICETITAN_ENABLED=false
FSM_SERVICETITAN_LIVE=false
# SERVICETITAN_CLIENT_ID=
# SERVICETITAN_CLIENT_SECRET=
# SERVICETITAN_APP_KEY=
FSM_HOUSECALLPRO_ENABLED=false
FSM_HOUSECALLPRO_LIVE=false
# HOUSECALLPRO_API_KEY=
FSM_JOBBER_ENABLED=false

# Optional testing stack. ElevenLabs remains the primary voice option.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_SMS_MODEL=openai/gpt-4.1-mini
# DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
DEEPGRAM_SPEECH_MODEL=aura-2-thalia-en
# Select deepgram-openrouter in a client's Voice calls settings to test it.

# Personal dashboard owner account (optional; local demo uses the seeded agency owner).
# PERSONAL_ADMIN_EMAIL=
# PERSONAL_ADMIN_PASSWORD=
